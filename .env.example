# Réglages de démarrage de Poste (Docker Compose). Le reste se règle dans l'interface (Réglages)
# ou dans config/poste.toml (modèle : poste.exemple.toml).

# Port publié sur la machine.
POSTE_PORT=8541
TZ=Europe/Paris

# Adresses par lesquelles on ouvre Poste : nom d'hôte avec le port, et origine complète.
# Ajoute ton domaine si Poste est derrière un proxy HTTPS (Caddy, Traefik, Tailscale…), par exemple :
#   POSTE_HOTES=localhost:8541,127.0.0.1:8541,poste.exemple.fr
#   POSTE_ORIGINES=http://localhost:8541,https://poste.exemple.fr
POSTE_HOTES=localhost:8541,127.0.0.1:8541
POSTE_ORIGINES=http://localhost:8541,http://127.0.0.1:8541

# Cookie de session réservé au HTTPS. À laisser à 1 derrière un proxy HTTPS ou sur localhost ;
# à 0 seulement pour essayer en HTTP simple depuis une autre machine du réseau local.
POSTE_COOKIE_SECURE=1

# Éditeur de diagrammes (profil drawio) : adresse vue par le navigateur.
# POSTE_DRAWIO_PUBLIC=http://localhost:8543
NTFY_PORT=8546
DRAWIO_PORT=8543
